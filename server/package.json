{
  "name": "tanweer-server",
  "version": "1.0.0",
  "description": "Cloudflare Workers + D1 + R2 + Durable Objects backend for Tanweer School Platform",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply tanweer-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply tanweer-db --remote",
    "lint": "eslint src/ --ext .ts",
    "types": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^3.78.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
