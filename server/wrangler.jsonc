{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanweer",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanweer-db",
      "database_id": "c937c1d8-77dd-4292-a27c-43cf4bd78eae",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT",
        "class_name": "GroupChatDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GroupChatDO"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tanweer-staging-db",
          "database_id": "603edee6-c5f7-4158-8256-24b109110ec0",
          "migrations_dir": "src/db/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CHAT",
            "class_name": "GroupChatDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "GroupChatDO"
          ]
        }
      ],
      "observability": {
        "enabled": true
      }
    }
  }
}
